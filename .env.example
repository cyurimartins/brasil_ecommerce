# Copie para .env e ajuste se necessário: cp .env.example .env
# Todas as variáveis são opcionais — os padrões funcionam para rodar localmente.

# Diretório raiz dos dados (raw/ e warehouse.duckdb ficam aqui)
# BRECOM_DATA_DIR=./data

# Dataset de origem no Kaggle
# BRECOM_KAGGLE_DATASET=olistbr/brazilian-ecommerce

# Nível de log: DEBUG, INFO, WARNING, ERROR
# BRECOM_LOG_LEVEL=INFO
